# Keep pnpm from auto-installing react/react-dom as peers of the Midnight SDK
# packages in the node-only deploy toolchain. The SDK packages declare React
# peers (used opportunistically by @apollo/client), but the deploy pipeline is
# pure Node and should not drag a browser UI stack into its module tree. The
# node-only package @verishield/deploy-tools intentionally has no react peers;
# this flag makes that intent explicit regardless of what pnpm auto-install
# defaults are in effect.
auto-install-peers=false
node-linker=hoisted