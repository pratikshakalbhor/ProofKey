# Issuer API environment. Copy to `.env` and fill in real values.
# NOTE: the defaults baked into src/config.ts are for local demo only.

PORT=4000
NODE_ENV=development

# SQLite file for the issuer's internal database
DATABASE_PATH=./data/issuer.sqlite

# JWT session signing
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# AES-256-GCM key-encryption key for the institution private key.
# 32 bytes, hex (64 chars) or base64. In production this MUST come from a real
# KMS / HSM, never from a plain env var.
KEY_ENCRYPTION_KEY=

BCRYPT_ROUNDS=10

# Midnight network the issuer anchors to. Must match VITE_NETWORK in packages/web.
NETWORK_ID=undeployed

# Web origin allowed by CORS
CORS_ORIGIN=http://localhost:3000

# Rate limiting for auth endpoints
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
