pragma language_version >= 0.26;

import CompactStandardLibrary;

// ============================================================================
// VeriShield - Credential Registry
//
// On-chain registry of issuers, schemas and issued-credential commitments.
// The chain never stores personal data - only domain-separated commitments.
//
// Issuer authenticity is enforced IN-CIRCUIT: an issuer registers a JubJub
// verifying key, signs each credential commitment with the matching JubJub
// Schnorr signing key, and every claim circuit re-derives the commitment from
// the holder's private payload and verifies that signature with
// `jubjubSchnorrVerify`. Requires Compact compiler >= 0.34.0 (language 0.26,
// runtime 0.19.0), which is the first toolchain to bind the JubJub Schnorr
// primitives.
// ============================================================================

// 365.25 days, in seconds. Used for age predicates.
circuit secondsPerYear(): Uint<64> {
  return 31557600;
}

// Domain-separation tags. Hashing a tag first prevents cross-protocol
// collisions between the different commitment families.
circuit tagCredential(): Bytes<32> {
  return pad(32, "verishield:credential:v1");
}

// ---------------------------------------------------------------------------
// Types
// ---------------------------------------------------------------------------

export enum ClaimType {
  HAS_CREDENTIAL,
  FIELD_EQUALS,
  RANGE_PROOF,
  AGE_OVER,
  NOT_EXPIRED,
}

struct IssuerEntry {
  verifyingKey: JubjubPoint,
  name: Bytes<32>,
  registeredAt: Uint<64>,
  active: Boolean,
}

// Everything the credential holder proves knowledge of. Kept entirely
// private - only its commitment is ever anchored or revealed.
struct CredentialPayload {
  schemaId: Bytes<32>,
  holderBinding: Bytes<32>,
  nameHash: Bytes<32>,
  degree: Bytes<32>,
  dob: Uint<64>,
  cgpaTimes100: Uint<16>,
  issueDate: Uint<64>,
  expiryDate: Uint<64>,
}

// ---------------------------------------------------------------------------
// Ledger state
// ---------------------------------------------------------------------------

export ledger issuers: Map<Bytes<32>, IssuerEntry>;
export ledger schemaRegistry: Map<Bytes<32>, Bytes<32>>;
// leaf (issuerId, commitment) -> issuerId. The issuance accumulator.
export ledger issuedCommitments: Map<Bytes<32>, Bytes<32>>;
// Authoritative in-circuit non-membership set for revoked credentials.
export ledger revokedCredentials: Set<Bytes<32>>;
// Publicly published accumulator roots (audit anchors).
export ledger issuanceRoot: Bytes<32>;
export ledger revocationRoot: Bytes<32>;
export ledger issuerCount: Counter;
export ledger verificationCount: Counter;
// The one and only value a verifier ever observes from a proof.
export ledger lastProofValid: Boolean;

// ---------------------------------------------------------------------------
// Private witnesses
// ---------------------------------------------------------------------------

// The issuer's JubJub signing key. Used to prove control of the registered
// verifying key when the issuer mutates registry state.
witness issuerSigningKey(): JubjubScalar;
// The issuer's JubJub Schnorr signature over the credential commitment. The
// holder presents it; the claim circuits verify it against the issuer's
// on-chain verifying key.
witness credentialSignature(): JubjubSchnorrSignature;
witness credentialPayload(): CredentialPayload;
witness credentialSalt(): Bytes<32>;

// ---------------------------------------------------------------------------
// Internal helpers
// ---------------------------------------------------------------------------

circuit computeCommitment(p: CredentialPayload, salt: Bytes<32>): Bytes<32> {
  return persistentCommit<CredentialPayload>(p, salt);
}

circuit credentialLeaf(issuerId: Bytes<32>, commitment: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([tagCredential(), issuerId, commitment]);
}

// The signed message is the commitment, reinterpreted byte-per-field as a
// `Vector<32, Field>`. Off-chain signing uses the identical encoding.
circuit commitmentMessage(commitment: Bytes<32>): Vector<32, Field> {
  return commitment as Vector<32, Field>;
}

// ---------------------------------------------------------------------------
// Pure helpers. These are exported so off-chain TypeScript can derive the
// credential commitment and issuance leaf through exactly the same encoding
// the on-chain circuits use (see `pureCircuits` in the generated bindings).
// Pure circuits have no ledger or witness access.
// ---------------------------------------------------------------------------

export pure circuit commitmentFromPayload(
  schemaId: Bytes<32>,
  holderBinding: Bytes<32>,
  nameHash: Bytes<32>,
  degree: Bytes<32>,
  dob: Uint<64>,
  cgpaTimes100: Uint<16>,
  issueDate: Uint<64>,
  expiryDate: Uint<64>,
  salt: Bytes<32>
): Bytes<32> {
  const payload = CredentialPayload {
    schemaId: schemaId,
    holderBinding: holderBinding,
    nameHash: nameHash,
    degree: degree,
    dob: dob,
    cgpaTimes100: cgpaTimes100,
    issueDate: issueDate,
    expiryDate: expiryDate
  };
  return persistentCommit<CredentialPayload>(payload, salt);
}

export pure circuit leafFromCommitment(issuerId: Bytes<32>, commitment: Bytes<32>): Bytes<32> {
  return credentialLeaf(issuerId, commitment);
}

circuit requireActiveIssuer(issuerId: Bytes<32>): IssuerEntry {
  assert(issuers.member(disclose(issuerId)), "Unknown issuer");
  const issuer = issuers.lookup(disclose(issuerId));
  assert(issuer.active, "Issuer inactive");
  return issuer;
}

// The caller must control the JubJub signing key behind the registered
// verifying key.
circuit requireIssuerAuthority(issuerId: Bytes<32>): IssuerEntry {
  const issuer = requireActiveIssuer(issuerId);
  assert(ecMulGenerator(issuerSigningKey()) == issuer.verifyingKey, "Caller is not the registered issuer");
  return issuer;
}

// Shared prelude that every claim circuit runs. Verifies the issuer is
// registered and active, the schema is known, the credential commitment is
// anchored to this issuer, that it has not been revoked, and that the
// issuer's JubJub Schnorr signature covers the recomputed commitment. Returns
// the private payload so the caller can apply its own claim predicate.
circuit verifyCredential(issuerId: Bytes<32>, schemaId: Bytes<32>): CredentialPayload {
  const payload = credentialPayload();
  const commitment = computeCommitment(payload, credentialSalt());
  const leaf = credentialLeaf(disclose(issuerId), commitment);

  const issuer = requireActiveIssuer(issuerId);

  assert(schemaRegistry.member(disclose(schemaId)), "Unknown schema");
  assert(payload.schemaId == disclose(schemaId), "Credential schema mismatch");
  assert(issuedCommitments.member(leaf), "Credential was never issued by this issuer");
  assert(issuedCommitments.lookup(leaf) == disclose(issuerId), "Issuer does not match anchor");
  assert(!revokedCredentials.member(commitment), "Credential has been revoked");

  assert(
    jubjubSchnorrVerify<32>(commitmentMessage(commitment), credentialSignature(), issuer.verifyingKey),
    "Credential signature is not from the registered issuer"
  );

  return payload;
}

// ---------------------------------------------------------------------------
// Issuer management
// ---------------------------------------------------------------------------

// Registers a new issuer. Permissionless registration is intentional for the
// demo: the caller proves control of the signing key behind the verifying key
// that gets stored.
export circuit registerIssuer(issuerId: Bytes<32>, name: Bytes<32>, registeredAt: Uint<64>): [] {
  assert(!issuers.member(disclose(issuerId)), "Issuer already registered");
  const verifyingKey = ecMulGenerator(issuerSigningKey());
  const entry = IssuerEntry {
    verifyingKey: disclose(verifyingKey),
    name: disclose(name),
    registeredAt: disclose(registeredAt),
    active: true
  };
  issuers.insert(disclose(issuerId), entry);
  issuerCount.increment(1);
}

export circuit setIssuerActive(issuerId: Bytes<32>, active: Boolean): [] {
  const issuer = requireIssuerAuthority(issuerId);
  const updated = IssuerEntry {
    verifyingKey: issuer.verifyingKey,
    name: issuer.name,
    registeredAt: issuer.registeredAt,
    active: disclose(active)
  };
  issuers.insert(disclose(issuerId), updated);
}

export circuit registerSchema(schemaId: Bytes<32>, schemaHash: Bytes<32>): [] {
  assert(!schemaRegistry.member(disclose(schemaId)), "Schema already registered");
  schemaRegistry.insert(disclose(schemaId), disclose(schemaHash));
}

// ---------------------------------------------------------------------------
// Issuance + revocation (issuer authority)
// ---------------------------------------------------------------------------

export circuit anchorCredential(issuerId: Bytes<32>, commitment: Bytes<32>): Bytes<32> {
  requireIssuerAuthority(issuerId);
  const leaf = credentialLeaf(disclose(issuerId), disclose(commitment));
  assert(!issuedCommitments.member(leaf), "Credential already anchored");
  issuedCommitments.insert(leaf, disclose(issuerId));
  issuanceRoot = disclose(leaf);
  return disclose(leaf);
}

export circuit revokeCredential(issuerId: Bytes<32>, commitment: Bytes<32>): [] {
  requireIssuerAuthority(issuerId);
  revokedCredentials.insert(disclose(commitment));
  revocationRoot = disclose(commitment);
}

// Lets the issuer publish the root of an off-chain revocation accumulator so
// verifiers can pin the latest revoked set. The accumulator itself is the
// on-chain `revokedCredentials` set; this is the public audit anchor.
export circuit updateRevocationRoot(issuerId: Bytes<32>, root: Bytes<32>): [] {
  requireIssuerAuthority(issuerId);
  revocationRoot = disclose(root);
}

export circuit updateIssuanceRoot(issuerId: Bytes<32>, root: Bytes<32>): [] {
  requireIssuerAuthority(issuerId);
  issuanceRoot = disclose(root);
}

// ---------------------------------------------------------------------------
// Claim circuits - the only thing a verifier ever receives is `true`
// ---------------------------------------------------------------------------

circuit publishValid(): Boolean {
  lastProofValid = disclose(true);
  verificationCount.increment(1);
  return disclose(true);
}

// ClaimType.HAS_CREDENTIAL
export circuit proveHoldsCredential(issuerId: Bytes<32>, schemaId: Bytes<32>): Boolean {
  const _payload = verifyCredential(issuerId, schemaId);
  return publishValid();
}

// ClaimType.FIELD_EQUALS - e.g. "my degree is a BSc in Computer Science"
export circuit proveFieldEquals(issuerId: Bytes<32>, schemaId: Bytes<32>, expectedDegree: Bytes<32>): Boolean {
  const payload = verifyCredential(issuerId, schemaId);
  assert(payload.degree == disclose(expectedDegree), "Field does not match");
  return publishValid();
}

// ClaimType.RANGE_PROOF - e.g. "my CGPA is at least 7.5" (times 100)
export circuit proveRange(issuerId: Bytes<32>, schemaId: Bytes<32>, minCgpaTimes100: Uint<16>): Boolean {
  const payload = verifyCredential(issuerId, schemaId);
  assert(payload.cgpaTimes100 >= disclose(minCgpaTimes100), "Value below threshold");
  return publishValid();
}

// ClaimType.AGE_OVER - e.g. "I am at least 18"
export circuit proveAgeOver(issuerId: Bytes<32>, schemaId: Bytes<32>, minAge: Uint<16>): Boolean {
  const payload = verifyCredential(issuerId, schemaId);
  const threshold = (payload.dob + (disclose(minAge) as Uint<64>) * secondsPerYear()) as Uint<64>;
  assert(blockTimeGte(disclose(threshold)), "Holder is under the minimum age");
  return publishValid();
}

// ClaimType.NOT_EXPIRED
export circuit proveNotExpired(issuerId: Bytes<32>, schemaId: Bytes<32>): Boolean {
  const payload = verifyCredential(issuerId, schemaId);
  assert(blockTimeLt(disclose(payload.expiryDate)), "Credential has expired");
  return publishValid();
}
