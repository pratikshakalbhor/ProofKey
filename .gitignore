# the large proving keys (regenerate with `pnpm compile:contracts`).
packages/contracts/managed/*/keys/

# Root tooling state produced by pnpm setup / deploy / cli (devnet deploy
# reports, local wallet seed material, generated manifests). Never committed.
/managed/
