{
  "name": "verishield",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter @verishield/shared build && pnpm --filter issuer-api build && pnpm --filter web build",
    "dev:issuer": "pnpm --filter issuer-api dev",
    "compile:contracts": "pnpm --filter @verishield/contracts compile",
    "test:e2e-crypto": "pnpm --filter @verishield/shared test:e2e-crypto",
    "setup": "tsx src/setup.ts",
    "compile": "pnpm compile:contracts",
    "deploy": "tsx src/deploy.ts",
    "network": "tsx src/network.ts",
    "test": "vitest run",
    "cli": "tsx src/cli.ts",
    "frontend": "pnpm --filter web dev",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "pnpm -r typecheck"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@verishield/contracts": "workspace:*",
    "@verishield/deploy-tools": "workspace:*",
    "@verishield/shared": "workspace:*",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "tsx": "^4.23.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.0"
  }
}
