{
  "name": "verishield",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=packages/web",
    "build": "npm run build --workspace=packages/shared && npm run build --workspace=packages/issuer-api && npm run build --workspace=packages/web",
    "dev:issuer": "npm run dev --workspace=packages/issuer-api",
    "compile:contracts": "npm run compile --workspace=packages/contracts",
    "test:e2e-crypto": "npm run test:e2e-crypto --workspace=packages/shared",
    "setup": "tsx src/setup.ts",
    "compile": "npm run compile:contracts",
    "deploy": "tsx src/deploy.ts",
    "network": "tsx src/network.ts",
    "test": "vitest run",
    "cli": "tsx src/cli.ts",
    "frontend": "npm run dev --workspace=packages/web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@verishield/contracts": "*",
    "@verishield/deploy-tools": "*",
    "@verishield/shared": "*",
    "dotenv": "^16.4.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "tsx": "^4.23.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.0"
  }
}
